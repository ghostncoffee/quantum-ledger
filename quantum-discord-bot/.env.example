# Copy this file to .env and fill in the values below.

# Discord application credentials — create an application at
# https://discord.com/developers/applications, add a Bot user, and
# invite it to your org's server with the `bot` + `applications.commands` scopes.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Optional: your Discord server (guild) ID. When set, slash commands are
# registered instantly for that server. When unset, commands are registered
# globally and can take up to ~1 hour to appear.
DISCORD_GUILD_ID=

# Quantum Org Server connection.
# If running alongside quantum-org-server via Docker Compose on the same
# network, use its service name, e.g. http://quantum-org-server:3100
ORG_SERVER_URL=http://localhost:3100
ORG_SERVER_AUTH_TOKEN=
